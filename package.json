{
  "name": "musichub",
  "version": "2.9.5",
  "description": "MusicHub - десктопный музыкальный плеер-агрегатор",
  "author": "Mamba1230",
  "main": "main.js",
  "protocols": {
    "name": "MusicHub Protocol",
    "schemes": [
      "musichub"
    ]
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^34.5.8",
    "electron-builder": "^24.13.3",
    "vite": "^8.0.14",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7"
  },
  "dependencies": {
    "adm-zip": "^0.5.14",
    "easy-volume": "^1.2.0",
    "ws": "^8.18.0"
  },
  "build": {
    "appId": "com.musichub.app",
    "productName": "MusicHub",
    "copyright": "© 2026 MusicHub Labs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules/.cache",
      "!*.py",
      "!__pycache__",
      "!media_watcher.py",
      "!*.map"
    ],
    "extraResources": [
      {
        "from": "media_watcher.exe",
        "to": "media_watcher.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "artifactName": "MusicHub.Setup.${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MusicHub"
    },
    "portable": {
      "artifactName": "MusicHub.Portable.${version}.exe"
    }
  }
}
